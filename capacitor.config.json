{
  "appId": "com.wespeak.app",
  "appName": "We-speak",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "~/.android/release.keystore",
      "keystoreAlias": "release",
      "keystoreAliasPassword": "KEYSTORE_PASSWORD",
      "keystorePassword": "KEYSTORE_PASSWORD",
      "releaseType": "APK"
    }
  }
}
